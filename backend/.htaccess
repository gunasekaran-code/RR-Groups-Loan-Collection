# Pass Authorization headers to PHP under FastCGI / PHP-FPM / cPanel
<IfModule mod_rewrite.c>
    RewriteEngine On
    CGIPassAuth On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteCond %{HTTP:X-Authorization} .
    RewriteRule .* - [E=HTTP_X_AUTHORIZATION:%{HTTP:X-Authorization}]
</IfModule>

<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
    SetEnvIf X-Authorization "(.*)" HTTP_X_AUTHORIZATION=$1
</IfModule>

# Serve text as UTF-8 so Tamil is never reinterpreted in the host's default codepage
AddDefaultCharset utf-8
<IfModule mod_mime.c>
  AddCharset utf-8 .html .css .js .json .csv .xml .txt
</IfModule>
